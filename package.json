{
  "name": "medical-cheatsheet",
  "version": "1.0.0",
  "description": "Deutsche medizinische Rechner mit transparenten Formeln und Quellen",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "anatomy:build": "node scripts/build-anatomy.mjs",
    "anatomy:audit": "node scripts/build-anatomy.mjs --audit",
    "anatomy:map": "node scripts/build-map-anatomy.mjs",
    "anatomy:map:audit": "node scripts/build-map-anatomy.mjs --audit",
    "deploy": "bash scripts/deploy.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "anatomy:bsa": "node scripts/build-bsa-anatomy.mjs",
    "anatomy:bsa:audit": "node scripts/build-bsa-anatomy.mjs --audit",
    "anatomy:shock": "node scripts/build-shock-anatomy.mjs",
    "anatomy:shock:audit": "node scripts/build-shock-anatomy.mjs --audit",
    "anatomy:anion": "node scripts/build-anion-anatomy.mjs",
    "anatomy:anion:audit": "node scripts/build-anion-anatomy.mjs --audit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nagy135/medical-cheatsheet.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/nagy135/medical-cheatsheet/issues"
  },
  "homepage": "https://github.com/nagy135/medical-cheatsheet#readme",
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
